pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region where Terraform will provision resources')
    string(name: 'TF_STATE_BUCKET', defaultValue: 'harish-terraform-state-bucket', description: 'S3 bucket for Terraform state files')
    string(name: 'LOCK_TABLE', defaultValue: 'my-terraform-lock-table', description: 'DynamoDB table for Terraform state locking')
    string(name: 'ENVIRONMENT', defaultValue: 'dev', description: 'Deployment environment name')
    string(name: 'ECR_REGISTRY', defaultValue: '', description: 'ECR registry URL (e.g., 123456789.dkr.ecr.ap-south-1.amazonaws.com)')
    string(name: 'ECR_REPOSITORY', defaultValue: 'webapp', description: 'ECR repository name for app image')
    string(name: 'CODEBUILD_PROJECT', defaultValue: '', description: 'Optional: CodeBuild project name for Docker build (if empty, uses local Docker)')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: '', description: 'Optional Jenkins AWS credentials ID to bind AWS CLI environment variables')
    booleanParam(name: 'SKIP_BACKEND_CREATION', defaultValue: false, description: 'If true, do not attempt to create S3/DynamoDB backend resources')
    booleanParam(name: 'BUILD_AND_PUSH_IMAGE', defaultValue: false, description: 'If true, build and push Docker image to ECR via CodeBuild')
  }

  environment {
    AWS_REGION         = "${params.AWS_REGION}"
    TF_VAR_aws_region  = "${params.AWS_REGION}"
    // Environment will be managed via Terraform workspaces; do not export TF_VAR_environment here
    TF_VAR_state_bucket = "${params.TF_STATE_BUCKET}"
    TF_VAR_lock_table   = "${params.LOCK_TABLE}"
    GIT_COMMIT_SHORT   = ""
    IMAGE_TAG          = "${BUILD_NUMBER}-${GIT_COMMIT_SHORT}"
  }

  options {
    skipDefaultCheckout()
    timestamps()
    timeout(time: 45, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
          env.IMAGE_TAG = "${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
          def helper = sh(script: '''
            helper=$(find . -type f \( -path '*/ci/parse_branch_env' -o -path '*/ci/parse_branch_env.py' \) | head -n 1)
            if [ -n "$helper" ]; then
              echo "$helper"
            else
              echo ""
            fi
          ''', returnStdout: true).trim()
          env.BRANCH_HELPER_PATH = helper
          if (helper) {
            sh "chmod +x '${helper}' || true"
            echo "Branch helper found at ${helper}"
          } else {
            echo 'Branch helper not found; using fallback branch-to-env heuristics.'
          }
        }
      }
    }

    stage('Build and Push Docker Image') {
      when {
        expression { return params.BUILD_AND_PUSH_IMAGE && params.ECR_REGISTRY }
      }
      steps {
        script {
          if (params.AWS_CREDENTIALS_ID?.trim()) {
            withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
              echo "Building Docker image via AWS CodeBuild..."

              if (params.CODEBUILD_PROJECT) {
                sh """
                  aws codebuild batch-get-builds --ids \$(aws codebuild start-build \
                    --project-name ${params.CODEBUILD_PROJECT} \
                    --source-version ${env.GIT_COMMIT} \
                    --environment-variables-override \
                      name=AWS_ACCOUNT_ID,value=\$(aws sts get-caller-identity --query Account --output text) \
                      name=AWS_REGION,value=${AWS_REGION} \
                      name=IMAGE_REPO_NAME,value=${params.ECR_REPOSITORY} \
                      name=IMAGE_TAG,value=${IMAGE_TAG} \
                      name=ECR_REGISTRY,value=${params.ECR_REGISTRY} \
                    --query 'build.id' --output text) \
                    --region ${AWS_REGION}
                  
                  echo "CodeBuild job started. Monitor in AWS Console: https://console.aws.amazon.com/codesuite/codebuild"
                """
              } else {
                sh """
                  echo "CodeBuild project not specified. Using local Docker..."
                  
                  # Login to ECR
                  aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${params.ECR_REGISTRY}
                  
                  # Build image
                  docker build -t ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG} .
                  docker tag ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG} ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:latest
                  
                  # Push to ECR
                  docker push ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG}
                  docker push ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:latest
                  
                  echo "Docker image pushed to ECR: ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG}"
                """
              }
            }
          } else {
            echo "Building Docker image via AWS CodeBuild..."

            if (params.CODEBUILD_PROJECT) {
              sh """
                aws codebuild batch-get-builds --ids \$(aws codebuild start-build \
                  --project-name ${params.CODEBUILD_PROJECT} \
                  --source-version ${env.GIT_COMMIT} \
                  --environment-variables-override \
                    name=AWS_ACCOUNT_ID,value=\$(aws sts get-caller-identity --query Account --output text) \
                    name=AWS_REGION,value=${AWS_REGION} \
                    name=IMAGE_REPO_NAME,value=${params.ECR_REPOSITORY} \
                    name=IMAGE_TAG,value=${IMAGE_TAG} \
                    name=ECR_REGISTRY,value=${params.ECR_REGISTRY} \
                  --query 'build.id' --output text) \
                  --region ${AWS_REGION}
                
                echo "CodeBuild job started. Monitor in AWS Console: https://console.aws.amazon.com/codesuite/codebuild"
              """
            } else {
              sh """
                echo "CodeBuild project not specified. Using local Docker..."
                
                # Login to ECR
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${params.ECR_REGISTRY}
                
                # Build image
                docker build -t ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG} .
                docker tag ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG} ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:latest
                
                # Push to ECR
                docker push ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG}
                docker push ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:latest
                
                echo "Docker image pushed to ECR: ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${IMAGE_TAG}"
              """
            }
          }
        }
      }
    }

    // plugin validation removed; pipeline now uses `yq` on the agent to parse YAML mappings

    stage('Validate AWS Access') {
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided so Jenkins can use stored AWS secrets for isolated EC2/AWS access.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            sh 'aws sts get-caller-identity --region ${AWS_REGION}'
          }
        }
      }
    }

    stage('Prepare Backend') {
      when {
        expression { return !params.SKIP_BACKEND_CREATION }
      }
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided for backend creation in isolated Jenkins environments.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            dir('terraform') {
              sh """
                if ! aws s3api head-bucket --bucket ${params.TF_STATE_BUCKET} --region ${AWS_REGION} 2>/dev/null; then
                  echo "Creating Terraform state bucket: ${params.TF_STATE_BUCKET}"
                  aws s3api create-bucket --bucket ${params.TF_STATE_BUCKET} --region ${AWS_REGION} --create-bucket-configuration LocationConstraint=${AWS_REGION}
                else
                  echo "Terraform state bucket already exists: ${params.TF_STATE_BUCKET}"
                fi

                if ! aws dynamodb describe-table --table-name ${params.LOCK_TABLE} --region ${AWS_REGION} 2>/dev/null; then
                  echo "Creating Terraform lock table: ${params.LOCK_TABLE}"
                  aws dynamodb create-table \
                    --table-name ${params.LOCK_TABLE} \
                    --attribute-definitions AttributeName=LockID,AttributeType=S \
                    --key-schema AttributeName=LockID,KeyType=HASH \
                    --billing-mode PAY_PER_REQUEST \
                    --region ${AWS_REGION}
                else
                  echo "Terraform lock table already exists: ${params.LOCK_TABLE}"
                fi
              """
            }
          }
        }
      }
    }

    stage('Terraform Init') {
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided for Terraform operations in isolated Jenkins environments.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            dir('terraform') {
              sh """
                echo "Initializing Terraform backend with state bucket ${params.TF_STATE_BUCKET} and lock table ${params.LOCK_TABLE}"
                terraform init -reconfigure \
                  -backend-config="bucket=${params.TF_STATE_BUCKET}" \
                  -backend-config="key=terraform/terraform.tfstate" \
                  -backend-config="region=${AWS_REGION}" \
                  -backend-config="use_lockfile=true" \
                  -backend-config="dynamodb_table=${params.LOCK_TABLE}"
              """
            }
          }
        }
      }
    }

    stage('Select Workspace') {
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided for Terraform workspace selection and AWS access.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            dir('terraform') {
              script {
                // prefer explicit ENVIRONMENT parameter; otherwise derive from branch using mapping file
                def envParam = params.ENVIRONMENT?.trim()
                def branchName = env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'dev'
                def raw = envParam ?: branchName
                raw = raw.replaceAll('/','-')

                // Portable: prefer executable wrapper, then Python helper, otherwise fall back to heuristics
                def selected = null
                def helperPath = env.BRANCH_HELPER_PATH?.trim()
                def wrapperOk = 'missing'
                if (helperPath) {
                  wrapperOk = sh(script: "if [ -x '../${helperPath}' ]; then echo ok; else echo missing; fi", returnStdout: true).trim()
                }
                if (wrapperOk == 'ok') {
                  selected = sh(script: "../${helperPath} --branch '${branchName}' --env '${envParam}'", returnStdout: true).trim()
                } else {
                  def pythonCmd = sh(script: "command -v python3 >/dev/null 2>&1 && echo python3 || (command -v python >/dev/null 2>&1 && echo python) || echo missing", returnStdout: true).trim()
                  if (pythonCmd != 'missing' && helperPath?.endsWith('.py')) {
                    selected = sh(script: "${pythonCmd} ../${helperPath} --branch '${branchName}' --env '${envParam}'", returnStdout: true).trim()
                  } else if (pythonCmd != 'missing' && !helperPath) {
                    selected = sh(script: "${pythonCmd} ../ci/parse_branch_env.py --branch '${branchName}' --env '${envParam}'", returnStdout: true).trim()
                  } else {
                    echo "No wrapper or python helper available on agent; falling back to built-in heuristics"
                  }
                }

                if (!selected) {
                  def key = raw.toLowerCase()
                  if (key == 'main' || key == 'master' || key.startsWith('release') || key == 'prod') {
                    selected = 'prod'
                  } else if (key == 'develop' || key == 'dev' || key == 'development') {
                    selected = 'dev'
                  } else if (key == 'qa' || key == 'staging' || key == 'stage') {
                    selected = 'qa'
                  } else {
                    selected = raw.replaceAll('[^A-Za-z0-9_-]','-')
                  }
                }

                sh """
                  echo "Using Terraform workspace: ${selected} (derived from '${raw}')"
                  terraform workspace select ${selected} || terraform workspace new ${selected}
                """
              }
            }
          }
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided for Terraform validation in isolated Jenkins environments.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            dir('terraform') {
              sh 'terraform fmt -check'
              sh 'terraform validate'
            }
          }
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided for Terraform plan in isolated Jenkins environments.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            dir('terraform') {
              sh 'terraform plan -out=tfplan'
            }
          }
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        script {
          if (!params.AWS_CREDENTIALS_ID?.trim()) {
            error('AWS_CREDENTIALS_ID must be provided for Terraform apply in isolated Jenkins environments.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
            dir('terraform') {
              sh 'echo "Terraform apply will wait for AWS resources to finish creating, including EKS cluster creation."'
              sh 'terraform apply -auto-approve tfplan'
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo 'Terraform provisioning completed successfully.'
    }
    failure {
      echo 'Terraform provisioning failed. Review logs and fix any issues.'
    }
  }
}
