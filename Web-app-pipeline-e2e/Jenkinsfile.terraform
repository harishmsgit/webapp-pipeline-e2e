pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region for provisioning')
    string(name: 'TF_STATE_BUCKET', defaultValue: 'harish-terraform-state-bucket', description: 'S3 bucket for Terraform state')
    string(name: 'LOCK_TABLE', defaultValue: 'my-terraform-lock-table', description: 'DynamoDB table for Terraform locking')
    string(name: 'ENVIRONMENT', defaultValue: 'dev', description: 'Deployment environment name')
    string(name: 'ECR_REGISTRY', defaultValue: '', description: 'ECR registry URL')
    string(name: 'ECR_REPOSITORY', defaultValue: 'webapp', description: 'ECR repository name')
    string(name: 'CODEBUILD_PROJECT', defaultValue: '', description: 'Optional CodeBuild project for Docker build')
    choice(name: 'DOCKER_BUILD_METHOD', choices: 'AUTO\nLOCAL\nCODEBUILD', description: 'Docker build method')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: '', description: 'Jenkins AWS credentials ID or set AWS_CREDENTIALS_ID in the environment')
    booleanParam(name: 'SKIP_BACKEND_CREATION', defaultValue: false, description: 'Skip S3/DynamoDB backend creation')
    booleanParam(name: 'BUILD_AND_PUSH_IMAGE', defaultValue: false, description: 'Build and push Docker image to ECR')
  }

  environment {
    AWS_REGION = "${params.AWS_REGION}"
    TF_VAR_aws_region = "${params.AWS_REGION}"
    TF_VAR_state_bucket = "${params.TF_STATE_BUCKET}"
    TF_VAR_lock_table = "${params.LOCK_TABLE}"
    IMAGE_TAG = ''
  }

  options {
    skipDefaultCheckout()
    timestamps()
    timeout(time: 45, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.IMAGE_TAG = "${BUILD_NUMBER}-${sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()}"
          echo "Branch metadata: BRANCH_NAME=${env.BRANCH_NAME}, GIT_BRANCH=${env.GIT_BRANCH}"
        }
      }
    }

    stage('Build and Push Docker Image') {
      when {
        expression { return params.BUILD_AND_PUSH_IMAGE && params.ECR_REGISTRY }
      }
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }

          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            def buildMethod = params.DOCKER_BUILD_METHOD ?: 'AUTO'
            if (buildMethod == 'AUTO' && params.CODEBUILD_PROJECT?.trim()) {
              buildMethod = 'CODEBUILD'
            }

            if (buildMethod == 'CODEBUILD') {
              if (!params.CODEBUILD_PROJECT?.trim()) {
                error('CODEBUILD_PROJECT is required when DOCKER_BUILD_METHOD=CODEBUILD.')
              }
              sh """
                aws codebuild start-build --project-name ${params.CODEBUILD_PROJECT} --environment-variables-override \
                  name=AWS_REGION,value=${params.AWS_REGION} \
                  name=IMAGE_TAG,value=${env.IMAGE_TAG} \
                  name=ECR_REGISTRY,value=${params.ECR_REGISTRY} \
                  name=ECR_REPOSITORY,value=${params.ECR_REPOSITORY}
              """
            } else {
              sh """
                if ! command -v docker >/dev/null 2>&1; then
                  echo 'ERROR: Docker is not installed on the agent. Install Docker or set DOCKER_BUILD_METHOD=CODEBUILD.' >&2
                  exit 1
                fi
                aws ecr get-login-password --region ${params.AWS_REGION} | docker login --username AWS --password-stdin ${params.ECR_REGISTRY}
                docker build -t ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${env.IMAGE_TAG} .
                docker push ${params.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${env.IMAGE_TAG}
              """
            }
          }
        }
      }
    }

    stage('Validate AWS Access') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            sh 'aws sts get-caller-identity --region ${AWS_REGION}'
          }
        }
      }
    }

    stage('Prepare Backend') {
      when {
        expression { return !params.SKIP_BACKEND_CREATION }
      }
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir('terraform') {
              sh """
                if ! aws s3api head-bucket --bucket ${params.TF_STATE_BUCKET} --region ${AWS_REGION} 2>/dev/null; then
                  aws s3api create-bucket --bucket ${params.TF_STATE_BUCKET} --region ${AWS_REGION} --create-bucket-configuration LocationConstraint=${AWS_REGION}
                fi

                if ! aws dynamodb describe-table --table-name ${params.LOCK_TABLE} --region ${AWS_REGION} 2>/dev/null; then
                  aws dynamodb create-table --table-name ${params.LOCK_TABLE} --attribute-definitions AttributeName=LockID,AttributeType=S --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST --region ${AWS_REGION}
                fi
              """
            }
          }
        }
      }
    }

    stage('Terraform Init') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir('terraform') {
              sh """
                terraform init -reconfigure \
                  -backend-config="bucket=${params.TF_STATE_BUCKET}" \
                  -backend-config="key=terraform/terraform.tfstate" \
                  -backend-config="region=${AWS_REGION}" \
                  -backend-config="use_lockfile=true" \
                  -backend-config="dynamodb_table=${params.LOCK_TABLE}"
              """
            }
          }
        }
      }
    }

    stage('Select Workspace') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir('terraform') {
              def branchName = env.BRANCH_NAME ?: env.GIT_BRANCH ?: sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
              def rawName = params.ENVIRONMENT?.trim() ?: branchName
              def workspace = rawName.toLowerCase().replaceAll('[^a-z0-9_-]', '-')
              if (workspace in ['main','master','prod'] || workspace.startsWith('release')) {
                workspace = 'prod'
              } else if (workspace in ['develop','dev','development']) {
                workspace = 'dev'
              } else if (workspace in ['qa','staging','stage']) {
                workspace = 'qa'
              }

              sh """
                echo 'Using Terraform workspace: ${workspace}'
                terraform workspace select ${workspace} || terraform workspace new ${workspace}
              """
            }
          }
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir('terraform') {
              sh 'terraform fmt -check'
              sh 'terraform validate'
            }
          }
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir('terraform') {
              sh 'terraform plan -out=tfplan'
            }
          }
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or via Jenkins environment variable AWS_CREDENTIALS_ID.')
          }
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir('terraform') {
              sh 'terraform apply -auto-approve tfplan'
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo 'Terraform provisioning completed successfully.'
    }
    failure {
      echo 'Terraform provisioning failed. Review logs and fix any issues.'
    }
  }
}
