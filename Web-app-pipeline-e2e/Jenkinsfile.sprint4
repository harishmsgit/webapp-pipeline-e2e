pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region')
    string(name: 'AWS_ACCOUNT_ID', defaultValue: '495013583028', description: 'AWS account ID for ECR registry')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'awsId', description: 'Jenkins AWS credentials ID')
    string(name: 'ECR_REPO_NAME', defaultValue: 'web-app-sprint4', description: 'ECR repository name')
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image tag; defaults to BUILD_NUMBER')
    string(name: 'EKS_CLUSTER_NAME', defaultValue: 'java-spring-eks', description: 'EKS cluster name')
    string(name: 'K8S_NAMESPACE', defaultValue: 'webapp', description: 'Kubernetes namespace')
    booleanParam(name: 'RUN_DEPLOYMENT', defaultValue: true, description: 'Deploy to EKS after build')
  }

  options {
    skipDefaultCheckout()
    disableConcurrentBuilds()
    timestamps()
    timeout(time: 45, unit: 'MINUTES')
  }

  environment {
    AWS_REGION = "${params.AWS_REGION}"
    AWS_ACCOUNT_ID = "${params.AWS_ACCOUNT_ID}"
    ECR_REPO_NAME = "${params.ECR_REPO_NAME}"
    EKS_CLUSTER_NAME = "${params.EKS_CLUSTER_NAME}"
    K8S_NAMESPACE = "${params.K8S_NAMESPACE}"
    IMAGE_TAG = ""
    IMAGE_URI = ""
  }

  stages {
    stage('Checkout & Tag') {
      steps {
        checkout scm
        script {
          def awsAccountId = params.AWS_ACCOUNT_ID?.trim()
          def awsRegion = params.AWS_REGION?.trim()
          def ecrRepoName = params.ECR_REPO_NAME?.trim()

          echo "AWS_ACCOUNT_ID=${awsAccountId}"
          echo "AWS_REGION=${awsRegion}"
          echo "ECR_REPO_NAME=${ecrRepoName}"

          if (!awsAccountId || awsAccountId.equalsIgnoreCase('null') || !awsRegion || awsRegion.equalsIgnoreCase('null') || !ecrRepoName || ecrRepoName.equalsIgnoreCase('null')) {
            error('Missing required ECR parameters: AWS_ACCOUNT_ID, AWS_REGION, or ECR_REPO_NAME. Check your Jenkins job parameter values.')
          }

          def tag = params.IMAGE_TAG?.trim()
          if (!tag || tag.equalsIgnoreCase('null')) {
            def buildNumber = env.BUILD_NUMBER?.trim()
            def currentBuildNumber = currentBuild?.number?.toString()
            def buildId = env.BUILD_ID?.trim()

            echo "BUILD_NUMBER=${buildNumber}"
            echo "currentBuild.number=${currentBuildNumber}"
            echo "BUILD_ID=${buildId}"

            tag = buildNumber ?: currentBuildNumber ?: buildId
          }
          if (!tag || tag.equalsIgnoreCase('null')) {
            tag = "${System.currentTimeMillis()}"
          }

          env.IMAGE_TAG = "${tag}"
          env.IMAGE_URI = "${awsAccountId}.dkr.ecr.${awsRegion}.amazonaws.com/${ecrRepoName}:${tag}"
          echo "IMAGE_TAG=${env.IMAGE_TAG}"
          echo "Image URI: ${env.IMAGE_URI}"
        }
      }
    }

    stage('Build') {
      steps {
        script {
          def appDir = fileExists('app/package.json') ? 'app' :
                       (fileExists('Web-app-pipeline-e2e/app/package.json') ? 'Web-app-pipeline-e2e/app' : null)
          if (!appDir) {
            error('Could not locate app/package.json in workspace; check repository layout and checkout path.')
          }
          echo "Using app directory: ${appDir}"
          dir(appDir) {
            docker.image('node:18').inside {
              sh 'pwd && ls -la && npm install'
            }
          }
        }
      }
    }

    stage('Test') {
      steps {
        script {
          def appDir = fileExists('app/package.json') ? 'app' :
                       (fileExists('Web-app-pipeline-e2e/app/package.json') ? 'Web-app-pipeline-e2e/app' : null)
          if (!appDir) {
            error('Could not locate app/package.json in workspace; check repository layout and checkout path.')
          }
          echo "Using app directory: ${appDir}"
          dir(appDir) {
            docker.image('node:18').inside {
              sh 'pwd && ls -la && npm test'
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          def repoRoot = fileExists('app/package.json') ? '.' :
                         (fileExists('Web-app-pipeline-e2e/app/package.json') ? 'Web-app-pipeline-e2e' : null)
          if (!repoRoot) {
            error('Could not locate app/package.json in workspace; check repository layout and checkout path.')
          }
          def imageUri = env.IMAGE_URI?.trim()
          def imageTag = env.IMAGE_TAG?.trim()
          if (!imageUri || imageUri.equalsIgnoreCase('null')) {
            if (!imageTag || imageTag.equalsIgnoreCase('null')) {
              imageTag = params.IMAGE_TAG?.trim()
            }
            if (!imageTag || imageTag.equalsIgnoreCase('null')) {
              imageTag = env.BUILD_NUMBER?.trim() ?: currentBuild?.number?.toString() ?: env.BUILD_ID?.trim()
            }
            imageUri = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO_NAME}:${imageTag}"
          }
          echo "Using repository root: ${repoRoot}"
          echo "IMAGE_TAG=${imageTag}"
          echo "IMAGE_URI=${env.IMAGE_URI}"
          echo "Building Docker image: ${imageUri}"
          dir(repoRoot) {
            sh """
              docker build \
                --build-arg NODE_ENV=production \
                --tag '${imageUri}' \
                --file app/Dockerfile \
                app
            """
            sh "docker image inspect '${imageUri}' >/dev/null 2>&1"
            sh "docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}' | grep -F '${imageUri}' || true"
          }
        }
      }
    }

    stage('Push to ECR') {
      when {
        expression { return params.RUN_DEPLOYMENT }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          script {
            def awsAccountId = env.AWS_ACCOUNT_ID?.trim()
            def awsRegion = env.AWS_REGION?.trim()
            def ecrRepoName = env.ECR_REPO_NAME?.trim()
            def imageTag = env.IMAGE_TAG?.trim()
            if (!imageTag || imageTag.equalsIgnoreCase('null')) {
              imageTag = params.IMAGE_TAG?.trim()
            }
            if (!imageTag || imageTag.equalsIgnoreCase('null')) {
              imageTag = env.BUILD_NUMBER?.trim() ?: currentBuild?.number?.toString() ?: env.BUILD_ID?.trim()
            }

            echo "AWS_ACCOUNT_ID=${awsAccountId}"
            echo "AWS_REGION=${awsRegion}"
            echo "ECR_REPO_NAME=${ecrRepoName}"
            echo "IMAGE_TAG=${imageTag}"

            if (!awsAccountId || awsAccountId.equalsIgnoreCase('null') ||
                !awsRegion || awsRegion.equalsIgnoreCase('null') ||
                !ecrRepoName || ecrRepoName.equalsIgnoreCase('null') ||
                !imageTag || imageTag.equalsIgnoreCase('null')) {
              error('Invalid AWS/ECR parameter values: AWS_ACCOUNT_ID, AWS_REGION, ECR_REPO_NAME, or IMAGE_TAG is missing.')
            }

            def imageUri = "${awsAccountId}.dkr.ecr.${awsRegion}.amazonaws.com/${ecrRepoName}:${imageTag}"
            echo "ECR push target: ${imageUri}"

            sh """
              set -e
              aws ecr get-login-password --region ${awsRegion} | docker login \
                --username AWS --password-stdin ${awsAccountId}.dkr.ecr.${awsRegion}.amazonaws.com
              if ! aws ecr describe-repositories --repository-names ${ecrRepoName} --region ${awsRegion} >/dev/null 2>&1; then
                aws ecr create-repository --repository-name ${ecrRepoName} --region ${awsRegion} \
                  --image-tag-mutability IMMUTABLE --image-scanning-configuration scanOnPush=true
              fi
              if aws ecr describe-images --repository-name ${ecrRepoName} --image-ids imageTag=${imageTag} --region ${awsRegion} >/dev/null 2>&1; then
                echo "Image ${imageUri} already exists in ECR; skipping push."
              else
                docker image inspect ${imageUri} >/dev/null 2>&1 || {
                  echo "Local image not found: ${imageUri}"
                  docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}'
                  exit 1
                }
                docker push ${imageUri}
              fi
            """
          }
        }
      }
    }

    stage('Deploy to EKS') {
      when {
        expression { return params.RUN_DEPLOYMENT }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          dir('.') {
            sh """
              set -e
              export PATH=\"$HOME/bin:$PATH\"
              mkdir -p \"$HOME/bin\"
              if ! command -v kubectl >/dev/null 2>&1; then
                curl -L https://dl.k8s.io/release/v1.30.0/bin/linux/amd64/kubectl -o \"$HOME/bin/kubectl\"
                chmod +x \"$HOME/bin/kubectl\"
              fi
              echo \"Deploying image ${env.IMAGE_URI}\"
              aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER_NAME}
              kubectl create namespace ${K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
              sed \"s|REPLACE_IMAGE|${env.IMAGE_URI}|g\" k8s/deployment.yaml | kubectl apply -f -
              kubectl apply -f k8s/service.yaml
              kubectl apply -f k8s/hpa.yaml
              kubectl rollout status deployment/webapp -n ${K8S_NAMESPACE} --timeout=300s
            """
          }
        }
      }
    }

    stage('Verify Deployment') {
      when {
        expression { return params.RUN_DEPLOYMENT }
      }
      steps {
        sh '''
          kubectl get all -n ${K8S_NAMESPACE}
          kubectl get hpa -n ${K8S_NAMESPACE}
        '''
      }
    }
  }

  post {
    success {
      echo "Pipeline succeeded. Image deployed: ${IMAGE_URI}"
    }
    failure {
      echo "Pipeline failed. Review logs for details."
    }
  }
}
