def buildPipelineContext(script) {
  def awsAccountId = script.params.AWS_ACCOUNT_ID?.trim()
  def awsRegion = script.params.AWS_REGION?.trim()
  def ecrRepoName = script.params.ECR_REPO_NAME?.trim()

  if (!awsAccountId || awsAccountId.equalsIgnoreCase('null')) {
    script.error('AWS_ACCOUNT_ID is required.')
  }
  if (!awsRegion || awsRegion.equalsIgnoreCase('null')) {
    script.error('AWS_REGION is required.')
  }
  if (!ecrRepoName || ecrRepoName.equalsIgnoreCase('null')) {
    script.error('ECR_REPO_NAME is required.')
  }

  def appDir = script.env.APP_DIR?.trim()
  if (!appDir || appDir.equalsIgnoreCase('null')) {
    appDir = script.fileExists('app/package.json') ? 'app' :
             (script.fileExists('Web-app-pipeline-e2e/app/package.json') ? 'Web-app-pipeline-e2e/app' : null)
  }
  if (!appDir) {
    script.error('Could not locate app/package.json in workspace; check repository layout and checkout path.')
  }

  def repoRoot = script.env.REPO_ROOT?.trim()
  if (!repoRoot || repoRoot.equalsIgnoreCase('null')) {
    repoRoot = appDir.startsWith('Web-app-pipeline-e2e/') ? 'Web-app-pipeline-e2e' : '.'
  }

  def imageTag = script.env.IMAGE_TAG?.trim()
  if (!imageTag || imageTag.equalsIgnoreCase('null')) {
    imageTag = script.params.IMAGE_TAG?.trim()
  }
  if (!imageTag || imageTag.equalsIgnoreCase('null')) {
    imageTag = script.env.BUILD_NUMBER?.toString()?.trim()
  }
  if (!imageTag || imageTag.equalsIgnoreCase('null')) {
    imageTag = script.currentBuild?.number?.toString()?.trim()
  }
  if (!imageTag || imageTag.equalsIgnoreCase('null')) {
    imageTag = script.env.BUILD_ID?.toString()?.trim()
  }
  if (!imageTag || imageTag.equalsIgnoreCase('null')) {
    imageTag = script.sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
  }
  if (!imageTag || imageTag.equalsIgnoreCase('null')) {
    imageTag = "${System.currentTimeMillis()}"
  }

  def imageUri = script.env.IMAGE_URI?.trim()
  if (!imageUri || imageUri.equalsIgnoreCase('null')) {
    imageUri = "${awsAccountId}.dkr.ecr.${awsRegion}.amazonaws.com/${ecrRepoName}:${imageTag}"
  }

  return [
    awsAccountId: awsAccountId,
    awsRegion: awsRegion,
    ecrRepoName: ecrRepoName,
    appDir: appDir,
    repoRoot: repoRoot,
    imageTag: imageTag,
    imageUri: imageUri,
  ]
}

def applyPipelineContext(script, ctx) {
  script.env.APP_DIR = ctx.appDir
  script.env.REPO_ROOT = ctx.repoRoot
  script.env.IMAGE_TAG = ctx.imageTag
  script.env.IMAGE_URI = ctx.imageUri
}

def ensureKubectl(script, kubectlVersion) {
  script.sh("""
    set -e
    export PATH=\"\$HOME/bin:\$PATH\"
    mkdir -p \"\$HOME/bin\"
    if ! command -v kubectl >/dev/null 2>&1; then
      curl -L https://dl.k8s.io/release/${kubectlVersion}/bin/linux/amd64/kubectl -o \"\$HOME/bin/kubectl\"
      chmod +x \"\$HOME/bin/kubectl\"
    fi
  """)
}

pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region')
    string(name: 'AWS_ACCOUNT_ID', defaultValue: '495013583028', description: 'AWS account ID for ECR registry')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'awsId', description: 'Jenkins AWS credentials ID')
    string(name: 'ECR_REPO_NAME', defaultValue: 'web-app-sprint4', description: 'ECR repository name')
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image tag; defaults to BUILD_NUMBER')
    string(name: 'EKS_CLUSTER_NAME', defaultValue: 'java-spring-eks', description: 'EKS cluster name')
    string(name: 'K8S_NAMESPACE', defaultValue: 'webapp', description: 'Kubernetes namespace')
    booleanParam(name: 'RUN_DEPLOYMENT', defaultValue: true, description: 'Deploy to EKS after build')
  }

  options {
    skipDefaultCheckout()
    disableConcurrentBuilds()
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    timeout(time: 45, unit: 'MINUTES')
  }

  environment {
    AWS_REGION = "${params.AWS_REGION}"
    AWS_ACCOUNT_ID = "${params.AWS_ACCOUNT_ID}"
    ECR_REPO_NAME = "${params.ECR_REPO_NAME}"
    EKS_CLUSTER_NAME = "${params.EKS_CLUSTER_NAME}"
    K8S_NAMESPACE = "${params.K8S_NAMESPACE}"
    NODE_IMAGE = "node:18"
    KUBECTL_VERSION = "v1.30.0"
    REPO_ROOT = ""
    APP_DIR = ""
    IMAGE_TAG = ""
    IMAGE_URI = ""
  }

  stages {
    stage('Initialize Context') {
      steps {
        checkout scm
        script {
          def ctx = buildPipelineContext(this)
          applyPipelineContext(this, ctx)

          echo "Initialized pipeline context"
          echo "AWS_REGION=${ctx.awsRegion}"
          echo "ECR_REPO_NAME=${ctx.ecrRepoName}"
          echo "REPO_ROOT=${ctx.repoRoot}"
          echo "APP_DIR=${ctx.appDir}"
          echo "IMAGE_TAG=${ctx.imageTag}"
          echo "IMAGE_URI=${ctx.imageUri}"
        }
      }
    }

    stage('Install Dependencies') {
      steps {
        script {
          def ctx = buildPipelineContext(this)
          applyPipelineContext(this, ctx)

          def appDir = ctx.appDir
          echo "Using app directory: ${appDir}"
          dir(appDir) {
            docker.image(env.NODE_IMAGE).inside {
              sh 'pwd && ls -la && npm ci --no-audit --no-fund'
            }
          }
        }
      }
    }

    stage('Test') {
      steps {
        script {
          def ctx = buildPipelineContext(this)
          applyPipelineContext(this, ctx)

          def appDir = ctx.appDir
          echo "Using app directory: ${appDir}"
          dir(appDir) {
            docker.image(env.NODE_IMAGE).inside {
              sh 'pwd && ls -la && npm test'
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          def ctx = buildPipelineContext(this)
          applyPipelineContext(this, ctx)

          echo "Using repository root: ${ctx.repoRoot}"
          echo "Building image: ${ctx.imageUri}"
          dir(ctx.repoRoot) {
            sh """
              docker build \
                --build-arg NODE_ENV=production \
                --tag '${ctx.imageUri}' \
                --file app/Dockerfile \
                app
            """
            sh "docker image inspect '${ctx.imageUri}' >/dev/null 2>&1"
            sh "docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}' | grep -F '${ctx.imageUri}' || true"
          }
        }
      }
    }

    stage('Push to ECR') {
      when {
        expression { return params.RUN_DEPLOYMENT }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          script {
            def ctx = buildPipelineContext(this)
            applyPipelineContext(this, ctx)

            echo "AWS_ACCOUNT_ID=${ctx.awsAccountId}"
            echo "AWS_REGION=${ctx.awsRegion}"
            echo "ECR_REPO_NAME=${ctx.ecrRepoName}"
            echo "IMAGE_TAG=${ctx.imageTag}"
            echo "ECR push target: ${ctx.imageUri}"

            if (!ctx.awsAccountId || ctx.awsAccountId.equalsIgnoreCase('null') ||
                !ctx.awsRegion || ctx.awsRegion.equalsIgnoreCase('null') ||
                !ctx.ecrRepoName || ctx.ecrRepoName.equalsIgnoreCase('null') ||
                !ctx.imageTag || ctx.imageTag.equalsIgnoreCase('null') ||
                !ctx.imageUri || ctx.imageUri.equalsIgnoreCase('null')) {
              error('Invalid AWS/ECR values. Check parameters and build environment.')
            }

            sh """
              set -e
              aws ecr get-login-password --region ${ctx.awsRegion} | docker login \
                --username AWS --password-stdin ${ctx.awsAccountId}.dkr.ecr.${ctx.awsRegion}.amazonaws.com
              if ! aws ecr describe-repositories --repository-names ${ctx.ecrRepoName} --region ${ctx.awsRegion} >/dev/null 2>&1; then
                aws ecr create-repository --repository-name ${ctx.ecrRepoName} --region ${ctx.awsRegion} \
                  --image-tag-mutability IMMUTABLE --image-scanning-configuration scanOnPush=true
              fi
              if aws ecr describe-images --repository-name ${ctx.ecrRepoName} --image-ids imageTag=${ctx.imageTag} --region ${ctx.awsRegion} >/dev/null 2>&1; then
                echo "Image ${ctx.imageUri} already exists in ECR; skipping push."
              else
                docker image inspect ${ctx.imageUri} >/dev/null 2>&1 || {
                  echo "Local image not found: ${ctx.imageUri}"
                  docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}'
                  exit 1
                }
                docker push ${ctx.imageUri}
              fi
            """
          }
        }
      }
    }

    stage('Deploy to EKS') {
      when {
        expression { return params.RUN_DEPLOYMENT }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          script {
            def ctx = buildPipelineContext(this)
            applyPipelineContext(this, ctx)

            echo "Deploying image ${ctx.imageUri}"
            dir(ctx.repoRoot) {
              sh """
                set -e
                export PATH=\"$HOME/bin:$PATH\"
                mkdir -p \"$HOME/bin\"
                KUBECTL=\"$HOME/bin/kubectl\"
                if [ ! -x \"$KUBECTL\" ]; then
                  curl -L https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl -o \"$KUBECTL\"
                  chmod +x \"$KUBECTL\"
                fi
                aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER_NAME}
                \"$KUBECTL\" create namespace ${K8S_NAMESPACE} --dry-run=client -o yaml | \"$KUBECTL\" apply -f -
                sed \"s|REPLACE_IMAGE|${ctx.imageUri}|g\" k8s/deployment.yaml | \"$KUBECTL\" apply -f -
                \"$KUBECTL\" apply -f k8s/service.yaml
                \"$KUBECTL\" apply -f k8s/hpa.yaml
                \"$KUBECTL\" rollout status deployment/webapp -n ${K8S_NAMESPACE} --timeout=300s
              """
            }
          }
        }
      }
    }

    stage('Verify Deployment') {
      when {
        expression { return params.RUN_DEPLOYMENT }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          script {
            sh '''
              set -e
              export PATH="$HOME/bin:$PATH"
              mkdir -p "$HOME/bin"
              KUBECTL="$HOME/bin/kubectl"
              if [ ! -x "$KUBECTL" ]; then
                curl -L https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl -o "$KUBECTL"
                chmod +x "$KUBECTL"
              fi
              "$KUBECTL" get all -n ${K8S_NAMESPACE}
              "$KUBECTL" get hpa -n ${K8S_NAMESPACE}
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "Pipeline succeeded. Image deployed: ${env.IMAGE_URI ?: 'unknown'}"
    }
    failure {
      echo "Pipeline failed. Review logs for details."
    }
    always {
      cleanWs()
    }
  }
}
