pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region used by Terraform and EKS')
    string(name: 'TF_STATE_BUCKET', defaultValue: 'harish-terraform-state-bucket', description: 'S3 bucket for Terraform state')
    string(name: 'LOCK_TABLE', defaultValue: 'my-terraform-lock-table', description: 'DynamoDB table for Terraform locking')
    string(name: 'ENVIRONMENT', defaultValue: 'dev', description: 'Terraform workspace/environment to read outputs from')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'aws-credentials', description: 'Jenkins AWS credentials ID')
    string(name: 'SSH_PRIVATE_KEY_CREDENTIALS_ID', defaultValue: 'management-ec2-ssh-key', description: 'Jenkins SSH private key credentials for the management EC2 instance')
    string(name: 'REMOTE_USER', defaultValue: 'ubuntu', description: 'SSH user for the management EC2 instance')
  }

  environment {
    AWS_REGION = "${params.AWS_REGION}"
    TF_VAR_aws_region = "${params.AWS_REGION}"
    TF_VAR_state_bucket = "${params.TF_STATE_BUCKET}"
    TF_VAR_lock_table = "${params.LOCK_TABLE}"
  }

  options {
    skipDefaultCheckout()
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          def projectDir = sh(script: 'find . -type f -name "Jenkinsfile.ansible" | head -n 1 | sed -e "s|/Jenkinsfile.ansible$||" -e "s|^./||"', returnStdout: true).trim()
          if (!projectDir) {
            error('Project path not found. Ensure the repository contains Jenkinsfile.ansible.')
          }

          env.PROJECT_DIR = projectDir
          env.ANSIBLE_CONFIG = "${WORKSPACE}/${projectDir}/ansible/ansible.cfg"
          env.INVENTORY_FILE = "${WORKSPACE}/${projectDir}/ansible/inventories/generated/hosts.ini"
          env.TF_OUTPUT_FILE = "${WORKSPACE}/${projectDir}/ansible/terraform-outputs.json"
          echo "Project path: ${env.PROJECT_DIR}"
        }
      }
    }

    stage('Validate Tooling') {
      steps {
        dir(env.PROJECT_DIR) {
          sh '''
            . scripts/ensure_ansible.sh
            ansible --version
            terraform version
            aws --version
            python3 --version
          '''
        }
      }
    }

    stage('Read Terraform Outputs') {
      steps {
        script {
          def awsCreds = params.AWS_CREDENTIALS_ID?.trim() ?: env.AWS_CREDENTIALS_ID?.trim()
          if (!awsCreds) {
            error('AWS_CREDENTIALS_ID must be provided as a build parameter or Jenkins environment variable.')
          }

          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: awsCreds]]) {
            dir("${env.PROJECT_DIR}/terraform") {
              sh """
                terraform init -input=false -reconfigure \
                  -backend-config="bucket=${params.TF_STATE_BUCKET}" \
                  -backend-config="key=terraform/terraform.tfstate" \
                  -backend-config="region=${AWS_REGION}" \
                  -backend-config="use_lockfile=true" \
                  -backend-config="dynamodb_table=${params.LOCK_TABLE}"
                terraform workspace select ${params.ENVIRONMENT}
                terraform output -json > "${TF_OUTPUT_FILE}"
              """
            }
          }
        }
      }
    }

    stage('Generate Inventory') {
      steps {
        dir(env.PROJECT_DIR) {
          sh '''
            mkdir -p "$(dirname "${INVENTORY_FILE}")"
            python3 scripts/generate_ansible_inventory.py \
              --terraform-output "${TF_OUTPUT_FILE}" \
              --inventory "${INVENTORY_FILE}" \
              --remote-user "${REMOTE_USER}"
            echo "Generated inventory:" 
            cat "${INVENTORY_FILE}"
          '''
        }
      }
    }

    stage('Configure Management EC2') {
      steps {
        dir(env.PROJECT_DIR) {
          withCredentials([sshUserPrivateKey(credentialsId: params.SSH_PRIVATE_KEY_CREDENTIALS_ID, keyFileVariable: 'SSH_KEY_FILE', usernameVariable: 'SSH_USERNAME')]) {
            sh '''
              . scripts/ensure_ansible.sh
              export ANSIBLE_SSH_PRIVATE_KEY_FILE="$SSH_KEY_FILE"
              export ANSIBLE_REMOTE_USER="${REMOTE_USER}"
              echo "Using SSH key file: $SSH_KEY_FILE"
              echo "Using SSH user: ${REMOTE_USER}"
              echo "Inventory file: ${INVENTORY_FILE}"
              EKS_CLUSTER_NAME=$(python3 -c "import json; print(json.load(open('${TF_OUTPUT_FILE}'))['eks_cluster_name']['value'])")
              ansible-playbook -vvv \
                -i "${INVENTORY_FILE}" \
                ansible/playbooks/configure-management.yml \
                -e "aws_region=${AWS_REGION}" \
                -e "eks_cluster_name=${EKS_CLUSTER_NAME}" \
                -e "ansible_user=${REMOTE_USER}"
            '''
          }
        }
      }
    }

    stage('Validate Configuration') {
      steps {
        dir(env.PROJECT_DIR) {
          withCredentials([sshUserPrivateKey(credentialsId: params.SSH_PRIVATE_KEY_CREDENTIALS_ID, keyFileVariable: 'SSH_KEY_FILE', usernameVariable: 'SSH_USERNAME')]) {
            sh '''
              . scripts/ensure_ansible.sh
              export ANSIBLE_SSH_PRIVATE_KEY_FILE="$SSH_KEY_FILE"
              export ANSIBLE_REMOTE_USER="${REMOTE_USER}"
              echo "Validating SSH target with inventory:"
              cat "${INVENTORY_FILE}"
              ansible-playbook -vvv \
                -i "${INVENTORY_FILE}" \
                ansible/playbooks/validate-management.yml \
                -e "ansible_user=${REMOTE_USER}"
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo 'Ansible configuration completed and validated successfully.'
    }
    failure {
      echo 'Ansible configuration failed. Review connection, SSH key, and package installation logs.'
    }
  }
}
